# TN Happy Kids Playschool App - Environment Variables

# API Configuration
API_URL=http://192.168.1.100/lastchapter
API_TIMEOUT=30000

# Expo Configuration
EXPO_PROJECT_ID=your-project-id
EXPO_OWNER=dineshwebdev2003

# App Configuration
APP_NAME=TN Happy Kids
APP_VERSION=1.0.0
APP_BUILD=1

# Environment
NODE_ENV=development
DEBUG_MODE=true

# Database Configuration (for backend reference)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=happy
DB_USER=root
DB_PASSWORD=

# Push Notifications
EXPO_PUSH_TOKEN=your-expo-push-token

# Third-party Services
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Firebase (if using)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id

# Google Services (if using)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Social Login (if implementing)
GOOGLE_CLIENT_ID=your-google-client-id
FACEBOOK_APP_ID=your-facebook-app-id

# Security
JWT_SECRET=your-jwt-secret-key
ENCRYPTION_KEY=your-encryption-key

# Feature Flags
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_OFFLINE_MODE=false
ENABLE_BIOMETRIC_AUTH=false
ENABLE_DARK_MODE=true
ENABLE_MULTI_LANGUAGE=false
ENABLE_LIVE_CHAT=true
ENABLE_VIDEO_CALLS=false
ENABLE_PAYMENT_GATEWAY=true
ENABLE_GPS_TRACKING=true
